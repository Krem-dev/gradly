# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=gradlyDB
DB_SSL=false

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5050
FRONTEND_URL=http://localhost:8080

# Long random string (32+ chars). Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# ─── Email (optional) ────────────────────────────────────────────────────────
HOSTINGER_EMAIL=your_hostinger_email@example.com
HOSTINGER_PASSWORD=your_hostinger_password
HOSTINGER_SMTP=smtp.hostinger.com
HOSTINGER_PORT=465

# ─── Paystack (credits + payments) ───────────────────────────────────────────
# Get keys from https://dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CREDITS_PER_PACK=3
PACK_PRICE_PESEWAS=2000
CURRENCY=GHS

# ─── Anthropic Claude (transcript extraction) ───────────────────────────────
# Get a key from https://console.anthropic.com → Settings → API Keys
# Without this key, transcript upload falls back to a basic pdf-parse path
# (works for digital PDFs, fails on scans/photos).
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6
